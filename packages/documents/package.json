{
  "name": "@uw/documents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "pretest": "npm run build -w @uw/core",
    "test": "vitest run --passWithNoTests",
    "typecheck": "npm run build -w @uw/core && tsc --noEmit",
    "build": "npm run build -w @uw/core && tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@uw/contracts": "*",
    "@uw/core": "*",
    "@uw/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
