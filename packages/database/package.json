{
  "name": "@uw/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run build -w @uw/auth && tsc --noEmit",
    "build": "npm run build -w @uw/auth && tsup src/index.ts --format esm --dts --clean",
    "migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@uw/auth": "*",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0"
  }
}
