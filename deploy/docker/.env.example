# Copy this file to deploy/docker/.env for a local reference deployment.
# These values are development-only. Replace them before exposing an instance.
POSTGRES_USER=workbench
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workbench

# Keep this URI consistent with the PostgreSQL settings above.
# URL-encode reserved characters in the URI password if you use them.
DATABASE_URL=postgresql://workbench:change-me@postgres:5432/workbench
